@page "/Plugins/Mcp"
@namespace LANCommander.Mcp.Pages
@using LANCommander.Server.Plugins
@using LANCommander.Server.UI.Controls
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Text.Json
@implements IAsyncDisposable
@attribute [PluginAccess(PluginAccessLevel.Administrator)]
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>MCP setup</PageTitle>
<PageHeader Title="MCP setup" />
<PageContent>
    <Flex Vertical Gap="Gap.Medium">
        <p>Connect an MCP client to <code>@Endpoint</code> using an administrator access token.</p>
        <Alert Warning Title="Temporary session-token workaround">
            This uses LC's normal password login, not a permanent or MCP-scoped API key.
            Generating a token replaces this account's refresh token and can prevent other clients
            from refreshing their sessions. Use an administrator account. Password login must be enabled.
            Use HTTPS and keep MCP client approval enabled for mutations.
        </Alert>
        <form @ref="_form" @onsubmit="GenerateAsync" @onsubmit:preventDefault>
            <Flex Vertical Gap="Gap.Medium">
                <label>LC username <input name="username" autocomplete="username" required disabled="@_busy" /></label>
                <label>LC password <input name="password" type="password" autocomplete="current-password" required disabled="@_busy" /></label>
                <Checkbox @bind-Value="_acknowledged" Disabled="_busy">
                    I understand this creates an administrator session and replaces this account's refresh token.
                </Checkbox>
                <Button Primary Submit Loading="_busy" Disabled="@(!_acknowledged)">Generate access token</Button>
            </Flex>
        </form>
        @if (_error is not null)
        {
            <Alert Danger Title="MCP setup">@_error</Alert>
        }
        @if (_session is not null)
        {
            <Alert Info Title="Session token">
                Expires @_session.Expiration.ToUniversalTime().ToString("u").
                The refresh token is discarded. This page does not automatically renew tokens.
                Clear or leave this page when finished; clearing does not revoke the token.
            </Alert>
            <label>Access token
                <input type="password" value="@_session.AccessToken" readonly autocomplete="off" aria-label="Access token" />
            </label>
            <Flex Gap="Gap.Small">
                <Button OnClick="CopyTokenAsync">Copy access token</Button>
                <Button OnClick="CopyConfigurationAsync">Copy MCP configuration</Button>
                <Button OnClick="Clear">Clear token</Button>
            </Flex>
            <p>The copied configuration contains your token. Keep it private and do not commit it.</p>
        }
        @if (_message is not null)
        {
            <p role="status">@_message</p>
        }
    </Flex>
</PageContent>

@code {
    private ElementReference _form;
    private IJSObjectReference? _module;
    private TokenResult? _session;
    private bool _acknowledged;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string Endpoint => new Uri(new Uri(Navigation.BaseUri), "api/Plugins/Mcp").AbsoluteUri;

    private async Task<IJSObjectReference> ModuleAsync() =>
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
            new Uri(new Uri(Navigation.BaseUri), "api/Plugins/Mcp/setup.mjs").AbsoluteUri);

    private async Task GenerateAsync()
    {
        if (_busy || !_acknowledged)
            return;
        Clear();
        _busy = true;
        try
        {
            var module = await ModuleAsync();
            _session = await module.InvokeAsync<TokenResult>("login", _form, Navigation.BaseUri);
        }
        catch (JSException)
        {
            _error = "Could not generate a token. Check your credentials, HTTPS, and that password login is enabled. No token was saved.";
        }
        finally
        {
            _busy = false;
        }
    }

    private Task CopyTokenAsync() => CopyAsync(_session!.AccessToken);

    private Task CopyConfigurationAsync() => CopyAsync(JsonSerializer.Serialize(new
    {
        servers = new
        {
            lancommander = new
            {
                type = "http",
                url = Endpoint,
                headers = new Dictionary<string, string> { ["Authorization"] = $"Bearer {_session!.AccessToken}" }
            }
        }
    }, new JsonSerializerOptions { WriteIndented = true }));

    private async Task CopyAsync(string value)
    {
        _error = null;
        _message = null;
        try
        {
            var module = await ModuleAsync();
            await module.InvokeVoidAsync("copy", value);
            _message = "Copied to clipboard.";
        }
        catch (JSException)
        {
            _error = "Could not access the clipboard. Use HTTPS and allow clipboard access, or select the token and copy it manually.";
        }
    }

    private void Clear()
    {
        _session = null;
        _error = null;
        _message = null;
    }

    public async ValueTask DisposeAsync()
    {
        Clear();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    public sealed record TokenResult(string AccessToken, DateTimeOffset Expiration);
}
